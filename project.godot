; Engine configuration file.
; Godot 4.7. Hand-maintained: this project is built headless on the hub and
; never opened in the editor there.

config_version=5

[application]

config/name="Pack Hunt 3D"
config/description="Wolves and deer with an energy and gait model, in 3D. A second, independent implementation of nathandunn/pack-hunt in Godot 4/GDScript."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.035, 1)
textures/vram_compression/import_etc2_astc=true

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_mouse_from_touch=true
